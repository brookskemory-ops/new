# Copy this file to .env and fill in what you want to use.
# The app runs fine with none of these set — you just get manual entry and CSV
# import instead of bank sync and AI analysis.
#
# .env is gitignored. Never commit real keys.
#
# NOTE: SimpleFIN bank sync needs nothing here. You paste a Setup Token into the
# Accounts page and it stores the credential in the local database. If you only
# want automatic bank sync, SimpleFIN is the easier of the two options and this
# whole file stays empty.

# ---------------------------------------------------------------------------
# Bank linking (Plaid) — optional
# ---------------------------------------------------------------------------
# Sign up at https://dashboard.plaid.com/signup — free, no card required.
# Sandbox keys work immediately with fake banks; log in with user_good/pass_good.
# Production access requires a short application and is billed per linked
# account per month. See the README for the current process.
PLAID_CLIENT_ID=
PLAID_SECRET=
# "sandbox" for testing with fake data, "production" for your real bank.
PLAID_ENV=sandbox

# ---------------------------------------------------------------------------
# AI insights (Anthropic) — optional
# ---------------------------------------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
# Pay-as-you-go, no subscription. Each analysis costs a few cents and results
# are cached, so re-opening the Insights page is free.
ANTHROPIC_API_KEY=

# Which model to use. claude-opus-5 is the most capable; claude-sonnet-5 is
# cheaper and still good at this. Leave blank for the default (claude-opus-5).
ANTHROPIC_MODEL=

# ---------------------------------------------------------------------------
# Storage — optional
# ---------------------------------------------------------------------------
# Where the SQLite file lives. Defaults to ./data/ledger.db
# DATABASE_PATH=/absolute/path/to/ledger.db
